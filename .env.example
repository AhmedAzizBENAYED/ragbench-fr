# Copy to `.env` (git-ignored) and fill in what you need. Environment variables take precedence.
# Nothing here may change a result: experiment parameters live in configs/*.yaml (RunConfig).

# --- LLM provider API keys (standard names, no prefix). Only required by the provider in use.
# Groq API key.
GROQ_API_KEY=
# Google Gemini API key.
GEMINI_API_KEY=

# --- Infrastructure
# Base URL of the Ollama server (default: http://localhost:11434).
RAGBENCH_OLLAMA_BASE_URL=

# --- Paths (relative to the working directory)
# Corpus and splits (default: data).
RAGBENCH_DATA_DIR=
# Embedding and LLM response caches (default: .cache).
RAGBENCH_CACHE_DIR=
# Run artefacts (default: results).
RAGBENCH_RESULTS_DIR=

# --- Logging (logs go to stderr)
# DEBUG, INFO, WARNING, ERROR or CRITICAL (default: INFO).
RAGBENCH_LOG_LEVEL=
# json or console (default: json). Use `console` for readable logs in development.
RAGBENCH_LOG_FORMAT=
